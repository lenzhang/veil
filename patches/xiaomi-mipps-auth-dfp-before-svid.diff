+def wait_adapter_svid(root, timeout):
+    # piano (streamC2): the ADSP learns the SVID (Discover Identity/SVIDs)
+    # only after the DFP swap, so it reads 0000 until then
+    deadline = time.monotonic() + timeout
+    svid = current_adapter_svid(root)
+    while svid != XIAOMI_SVID and time.monotonic() < deadline:
+        time.sleep(0.1)
+        svid = current_adapter_svid(root)
+    return svid
+
+
+def wait_pd_type(root, timeout):
+    # piano reports the BC1.2/Type-C type before the PD contract
+    deadline = time.monotonic() + timeout
+    while True:
+        try:
+            rt = read_node(root, "real_type")
+        except OSError:
+            return False
+        if rt in ("PD", "PD_PPS"):
+            return True
+        if time.monotonic() >= deadline:
+            print(f"real_type={rt}")
+            return False
+        time.sleep(0.1)
+
+
+def restore_ufp(root, role_before):
+    if role_before != "ufp" or not os.path.exists(os.path.join(root, "data_role")):
+        return
+    try:
+        if read_node(root, "data_role") == "dfp":
+            write_node(root, "data_role", "ufp")
+            print("data_role restored to ufp")
+    except OSError as e:
+        print(f"warning: failed to restore the ufp data role: {e}", file=sys.stderr)
