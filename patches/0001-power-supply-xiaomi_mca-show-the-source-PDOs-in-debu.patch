From baf271b8982e6451e1afb20286b1aa891814c7bf Mon Sep 17 00:00:00 2001
From: leozhang <zwj8727@gmail.com>
Date: Tue, 10 Nov 2026 10:27:06 +0800
Subject: [PATCH] power: supply: xiaomi_mca: show the source PDOs in debugfs

Direct charging needs a PPS APDO, but nothing showed which objects the
ADSP decoded from the source capabilities: UCSI lists PD_PPS among the
supported USB types whatever the partner offers. Add a read-only
debugfs file listing them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/xiaomi_mca.c | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/drivers/power/supply/xiaomi_mca.c b/drivers/power/supply/xiaomi_mca.c
index 635d97a..9422a17 100644
--- a/drivers/power/supply/xiaomi_mca.c
+++ b/drivers/power/supply/xiaomi_mca.c
@@ -3341,6 +3341,36 @@ static int xiaomi_mca_notifications_show(struct seq_file *s, void *unused)
 }
 DEFINE_SHOW_ATTRIBUTE(xiaomi_mca_notifications);
 
+/*
+ * The source objects as the ADSP decoded them: fixed PDOs have min == max,
+ * PPS APDOs min < max. Direct charging needs an APDO reaching
+ * 2 * MCA_CP_VBAT_MAX_MV + MCA_CP_DELTA_MV.
+ */
+static int xiaomi_mca_pdos_show(struct seq_file *s, void *unused)
+{
+	struct xiaomi_mca *mca = s->private;
+	struct xiaomi_mca_pdo pdos[MCA_PD_MAX_PDOS];
+	int i, ret;
+
+	scoped_guard(mutex, &mca->lock)
+		ret = xiaomi_mca_read_blob(mca, MCA_PROP_PDOS, pdos, sizeof(pdos));
+	if (ret)
+		return ret;
+
+	for (i = 0; i < MCA_PD_MAX_PDOS; i++) {
+		u32 min_mv = le32_to_cpu(pdos[i].min_mv);
+		u32 max_mv = le32_to_cpu(pdos[i].max_mv);
+
+		if (!max_mv)
+			continue;
+		seq_printf(s, "%d %s %u-%u mV %u mA\n", i,
+			   min_mv < max_mv ? "pps" : "fixed", min_mv, max_mv,
+			   le32_to_cpu(pdos[i].max_ma));
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(xiaomi_mca_pdos);
+
 static void xiaomi_mca_stop_poll(void *data)
 {
 	struct xiaomi_mca *mca = data;
@@ -3704,6 +3734,7 @@ static int xiaomi_mca_probe(struct auxiliary_device *adev,
 	debugfs_create_file("frames", 0400, mca->debugfs, mca, &xiaomi_mca_frames_fops);
 	debugfs_create_file("notifications", 0400, mca->debugfs, mca,
 			    &xiaomi_mca_notifications_fops);
+	debugfs_create_file("pdos", 0400, mca->debugfs, mca, &xiaomi_mca_pdos_fops);
 	ret = devm_add_action_or_reset(dev, xiaomi_mca_debugfs_remove, mca->debugfs);
 	if (ret)
 		return ret;
-- 
