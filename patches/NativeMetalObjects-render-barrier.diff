 /// SPI `setLineWidth:`: the runtime accepts Metal's default width of 1 and refuses any other (Apple's wide-line rule is unmeasured).
+/// `-[MTLRenderCommandEncoder memoryBarrierWithScope:afterStages:beforeStages:]`: the runtime splits the pass where a
+/// later draw reads what an earlier one wrote. RenderBox accumulates path coverage in a render target and reads it back in
+/// the same encoder; with the call dropped, SwiftUI glyphs and IconRendering icons came out as blocks or nothing.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_render_memory_barrier(encoder: *mut NmbEncoder, scope: u64, after: u64, before: u64) -> bool {
+    guard(false, || {
+        let scope = raw::<BarrierScope>(scope, "barrier scope")?;
+        let after = raw::<RenderStages>(after, "render stages")?;
+        let before = raw::<RenderStages>(before, "render stages")?;
+        render(encoder)?.memory_barrier_with_scope(scope, after, before);
+        Ok(true)
+    })
+}
