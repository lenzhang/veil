+#!/bin/bash
+# Build the stage-3 anchor variant (CROSVM_GHK_HANDOFF) from the COPY ~/vm/src/crosvm-ghk and install it as
+# ~/vm/bin/crosvm-ghk only. Same features/env as ~/vm/build-crosvm-gpu.sh; never touches crosvm-mmio-gpu.
+set -u
+export http_proxy=http://127.0.0.1:7890 https_proxy=http://127.0.0.1:7890 all_proxy=http://127.0.0.1:7890
+source $HOME/.cargo/env
+P=$HOME/vm/opt/virgl; L=$HOME/vm/logs; mkdir -p $L
+PC=$(dirname $(find $P -name virglrenderer.pc | head -1))
+cd $HOME/vm/src/crosvm-ghk
+FEAT=gunyah,audio,audio_aaudio,libaaudio_alsa,balloon,config-file,qcow,net,gpu,usb,vnc,virgl_renderer,media
+BINDGEN_EXTRA_CLANG_ARGS=-I/usr/include/aarch64-linux-gnu CROSVM_USE_SYSTEM_VIRGLRENDERER=1 CROSVM_USE_SYSTEM_MINIGBM=1 PKG_CONFIG_PATH=$PC nice -n 15 ionice -c3 cargo +1.86.0 build --release -j ${JOBS:-2} --no-default-features --features "$FEAT" > $L/crosvm-ghk.log 2>&1
+rc=$?; echo "rc=$rc" >> $L/crosvm-ghk.log
+[ $rc = 0 ] && cp target/release/crosvm $HOME/vm/bin/crosvm-ghk.new && mv -f $HOME/vm/bin/crosvm-ghk.new $HOME/vm/bin/crosvm-ghk && echo installed >> $L/crosvm-ghk.log
