+/* max_run_ms expired: kick every vcpu thread out of GUNYAH_VCPU_RUN; they leave their loop and park. */
+static void ghk_deadline(struct timer_list *t)
+{
+	struct ghk_vm *vm = container_of(t, struct ghk_vm, deadline);
+	unsigned int i;
+
+	WRITE_ONCE(vm->timed_out, true);
+	for (i = 0; i < vm->nr_vcpus; i++) {
+		struct ghk_vcpu *kv = &vm->vcpus[i];
+
+		if (!kv->task)
+			continue;
+		WRITE_ONCE(kv->vcpu->vcpu_run->immediate_exit, 1);
+		send_sig(SIGKILL, kv->task, 1);
+	}
+	pr_warn("max_run_ms expired: vcpu threads kicked out\n");
+}
