+#!/bin/bash
+# Build the anchor variant (CROSVM_GHK_HANDOFF) from the COPY ~/vm/src/crosvm-ghk and install it as
+# ~/vm/bin/$OUT only (default OUT=crosvm-ghk; stage 4: OUT=crosvm-ghk.abi3). Same features/env as
+# ~/vm/build-crosvm-gpu.sh; never touches crosvm-mmio-gpu.
+set -u
+OUT=${OUT:-crosvm-ghk}
+case $OUT in crosvm-ghk|crosvm-ghk.*) ;; *) echo "OUT must be crosvm-ghk or crosvm-ghk.<suffix>"; exit 1;; esac
+export http_proxy=http://127.0.0.1:7890 https_proxy=http://127.0.0.1:7890 all_proxy=http://127.0.0.1:7890
+source $HOME/.cargo/env
+P=$HOME/vm/opt/virgl; L=$HOME/vm/logs; mkdir -p $L
+LOG=$L/$OUT.log
+PC=$(dirname $(find $P -name virglrenderer.pc | head -1))
+cd $HOME/vm/src/crosvm-ghk
+FEAT=gunyah,audio,audio_aaudio,libaaudio_alsa,balloon,config-file,qcow,net,gpu,usb,vnc,virgl_renderer,media
+BINDGEN_EXTRA_CLANG_ARGS=-I/usr/include/aarch64-linux-gnu CROSVM_USE_SYSTEM_VIRGLRENDERER=1 CROSVM_USE_SYSTEM_MINIGBM=1 PKG_CONFIG_PATH=$PC nice -n 15 ionice -c3 cargo +1.86.0 build --release -j ${JOBS:-2} --no-default-features --features "$FEAT" > $LOG 2>&1
+rc=$?; echo "rc=$rc" >> $LOG
+[ $rc = 0 ] && cp target/release/crosvm $HOME/vm/bin/$OUT.tmp && mv -f $HOME/vm/bin/$OUT.tmp $HOME/vm/bin/$OUT && echo "installed $HOME/vm/bin/$OUT" >> $LOG
