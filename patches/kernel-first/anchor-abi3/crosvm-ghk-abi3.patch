+/// Serve forwarded MMIO exits: one GHK_IOC_MMIO_XFER per access completes the previous answer and fetches the
+/// next request. Mirrors vcpu.rs `VcpuExit::Mmio` (Bus::read zero-fills unmapped reads; at most 32 distinct
+/// unmapped addresses are logged).
+fn mmio_server(ghk: &File, bus: Bus, nr_vcpus: usize, stop: &AtomicBool) {
+    // one Bus clone per vcpu, so BusAccessInfo::id is the vcpu index as in the userspace vcpu threads
+    let buses: Vec<Bus> = (0..nr_vcpus)
+        .map(|i| {
+            let mut b = bus.clone();
+            b.set_access_id(i);
+            b
+        })
+        .collect();
+    drop(bus);
+    let mut unmapped = std::collections::BTreeSet::new();
+    let mut x = GhkMmioXfer { wait_ms: GHK_MMIO_WAIT_MS, ..Default::default() };
+    let (mut served, mut stale) = (0u64, 0u64);
+    info!("GHK: mmio server running ({nr_vcpus} vcpu(s))");
+    loop {
+        if stop.load(Ordering::SeqCst) {
+            break;
+        }
+        match raw_ioctl(ghk.as_raw_fd(), GHK_IOC_MMIO_XFER, &mut x as *mut GhkMmioXfer as u64) {
+            Ok(_) => {}
+            Err(e) => match e.raw_os_error() {
+                Some(libc::ENOTCONN) => break,
+                Some(libc::EINTR) => continue, // nothing consumed: retry the same completion
+                Some(libc::ESTALE) => {
+                    // the vcpu gave up on this request (timeout or stop); drop the answer, keep serving
+                    stale += 1;
+                    warn!("GHK: stale MMIO answer seq {} gpa {:#x}", x.done.seq, x.done.phys_addr);
+                    x.flags = 0;
+                    continue;
+                }
+                _ => {
+                    error!("GHK: GHK_IOC_MMIO_XFER: {e}; mmio server stops (the vcpu will time out)");
+                    break;
+                }
+            },
+        }
+        x.flags = 0;
+        let req = x.next;
+        if req.seq == 0 {
+            continue;
+        }
+        let len = (req.len as usize).min(8);
+        let vcpu = req.vcpu as usize;
+        let mut done = req;
+        if vcpu >= buses.len() || len == 0 {
+            error!("GHK: malformed MMIO request {:?}; answering 0", req);
+            done.data = [0; 8];
+        } else if req.is_write != 0 {
+            if !buses[vcpu].write(req.phys_addr, &req.data[..len])
+                && unmapped.len() < 32
+                && unmapped.insert((req.phys_addr, true))
+            {
+                warn!("MMIO-UNMAPPED: vcpu={} write gpa={:#x} len={} (ghk)", vcpu, req.phys_addr, len);
+            }
+        } else {
+            done.data = [0; 8];
+            if !buses[vcpu].read(req.phys_addr, &mut done.data[..len])
+                && unmapped.len() < 32
+                && unmapped.insert((req.phys_addr, false))
+            {
+                warn!("MMIO-UNMAPPED: vcpu={} read gpa={:#x} len={} (ghk)", vcpu, req.phys_addr, len);
+            }
+        }
+        served += 1;
+        x.done = done;
+        x.flags = GHK_MMIO_COMPLETE;
+    }
+    info!("GHK: mmio server done: {served} access(es) served, {stale} stale");
+}
