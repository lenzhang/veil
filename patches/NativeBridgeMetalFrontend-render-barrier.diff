+// Render-pass barriers off while /Library/Preferences/com.droidvm.nmb-no-render-barrier exists (read once per process; a process
+// whose sandbox cannot see the file keeps them on): the A/B switch for them without restaging the plugin.
+static bool nbRenderBarriers() {
+ static int on = -1;
+ if (on < 0) on = access("/Library/Preferences/com.droidvm.nmb-no-render-barrier", F_OK) != 0;
+ return on;
+}
 @implementation NBRenderEncoder
+// Render-pass memory barriers (the bridge splits the pass): RenderBox reads back, in the same encoder, the coverage an earlier draw
+// accumulated in a render target; dropped, SwiftUI glyphs and IconRendering icons drew as blocks or nothing (piano, 2026-11-10).
+- (void)memoryBarrierWithScope:(MTLBarrierScope)scope afterStages:(MTLRenderStages)after beforeStages:(MTLRenderStages)before {
+ if (!nbRenderBarriers()) return;
+ ENCODE([self check:nmb_render_memory_barrier(self.handle,scope,after,before) what:"render memory barrier"]);
+}
+- (void)memoryBarrierWithResources:(const id<MTLResource> __unsafe_unretained [])resources count:(NSUInteger)count afterStages:(MTLRenderStages)after beforeStages:(MTLRenderStages)before {
+ (void)resources;(void)count;
+ if (!nbRenderBarriers()) return;
+ ENCODE([self check:nmb_render_memory_barrier(self.handle,MTLBarrierScopeBuffers|MTLBarrierScopeTextures|MTLBarrierScopeRenderTargets,after,before) what:"render memory barrier"]);
+}
