+	event.surface_descriptor = input->touch_slots[slot].surface;
+	event.event_type = DWL_EVENT_TYPE_TOUCH_UP;
+	event.params[2] = slot;
+	input->touch_slots[slot].active = false;
+	input->touch_slots[slot].surface = NULL;
