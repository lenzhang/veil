+static void wl_touch_down(void *data, struct wl_touch *wl_touch, uint32_t serial, uint32_t time,
+			  struct wl_surface *surface, int32_t id, wl_fixed_t x, wl_fixed_t y)
+{
+	struct dwl_context *context = (struct dwl_context *)data;
+	struct input *input = &context->input;
+	struct dwl_event event = {0};
+	int slot;
+	(void)wl_touch;
+	(void)serial;
+	(void)time;
+
+	if (dwl_touch_slot(input, id) >= 0)
+		return;
+	for (slot = 0; slot < DWL_POINTER_TOUCH_SLOT; slot++)
+		if (!input->touch_slots[slot].active)
+			break;
+	if (slot == DWL_POINTER_TOUCH_SLOT)
+		return; // more fingers than the guest keeps
+	input->touch_slots[slot].active = true;
+	input->touch_slots[slot].id = id;
+	input->touch_slots[slot].surface = surface;
+	event.surface_descriptor = surface;
+	event.event_type = DWL_EVENT_TYPE_TOUCH_DOWN;
+	event.params[0] = dwl_input_coord(context, surface, x);
+	event.params[1] = dwl_input_coord(context, surface, y);
+	event.params[2] = slot;
+	dwl_context_push_event(context, &event);
