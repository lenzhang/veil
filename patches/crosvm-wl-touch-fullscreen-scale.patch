+// piano: soong 里 libvnc_server_bridge 是单独的 cc_library_static；cargo 构建要自己编它（vnc feature）
+fn build_vnc() {
+    let mut build = cc::Build::new();
+    build.flag("-std=gnu11");
+    build.include("src");
+    build.file("src/vnc_server_bridge.c");
+    build.file("src/vnc_h264_rfb.c");
+    println!("cargo:rerun-if-changed=src/vnc_server_bridge.c");
+    println!("cargo:rerun-if-changed=src/vnc_h264_rfb.c");
+    build.compile("vnc_server_bridge");
+    println!("cargo:rustc-link-lib=dylib=vncserver");
+}
