+/// A USERPTR queue the host driver does not take (Iris answers USERPTR with `EINVAL`: it has MMAP
+/// and DMABUF), emulated on MMAP buffers of the host's. The guest sees USERPTR buffers only, its
+/// addresses echoed back; QBUF copies an OUTPUT buffer's payload from the guest's pages into the
+/// host buffer, a dequeued CAPTURE buffer's payload is copied out into them. For guests whose
+/// virtio-media device has no shared-memory window to map MMAP buffers through (crosvm on Gunyah,
+/// where the GPU's took the room).
+struct ShadowQueue<R> {
+    queue: QueueType,
+    buffers: Vec<ShadowBuffer<R>>,
+}
+
+struct ShadowBuffer<R> {
+    /// The host buffer's planes, mapped here, and their MMAP offsets.
+    planes: Vec<(PlaneMapping, u32)>,
+    /// While queued: the guest's buffer as it was given, and its planes mapped (`None` for a
+    /// plane of length 0).
+    guest: Option<(V4l2Buffer, Vec<Option<R>>)>,
+}
+
+fn guest_userptrs(buffer: &V4l2Buffer) -> Vec<GuestAddrType> {
+    match buffer.planes_with_backing_iter() {
+        V4l2PlanesWithBacking::UserPtr(planes) => planes.map(|p| p.userptr()).collect(),
+        _ => vec![],
+    }
+}
+
+fn set_memory(buffer: &mut V4l2Buffer, memory: MemoryType) {
+    // SAFETY: only the memory type changes; the caller rewrites every plane's backing next.
+    unsafe { (*buffer.as_mut_ptr()).memory = memory as u32 };
+}
+
+/// A host buffer of a shadowed queue as the guest knows it: USERPTR, with the guest's addresses
+/// (those of `guest`, or 0 for a buffer the guest has not queued).
+fn shadow_buffer_to_guest(host_buffer: &V4l2Buffer, guest: Option<&V4l2Buffer>) -> V4l2Buffer {
+    let addrs = guest.map(guest_userptrs).unwrap_or_default();
+    let mut buffer = host_buffer.clone();
+    set_memory(&mut buffer, MemoryType::UserPtr);
+    if let V4l2PlanesWithBackingMut::UserPtr(planes) = buffer.planes_with_backing_iter_mut() {
+        for (i, mut plane) in planes.enumerate() {
+            plane.set_userptr(addrs.get(i).copied().unwrap_or(0));
+        }
+    }
+    buffer
+}
