+                    .min(host_plane.size())
+                    .min(mapping.len())
+                    .min(guest_lengths.get(i).copied().unwrap_or(0) as usize);
+                // SAFETY: `n` is within both the host plane's mapping and the guest's.
+                unsafe {
+                    std::ptr::copy_nonoverlapping(host_plane.as_ref().as_ptr(), mapping.as_mut_ptr(), n)
+                };
+            }
+        }
+        drop(mappings);
+        shadow_buffer_to_guest(&host_buffer, Some(&guest_buffer))
+    }
