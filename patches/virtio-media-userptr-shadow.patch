+impl<Q, M, HM> V4l2ProxyDevice<Q, M, HM>
+where
+    Q: VirtioMediaEventQueue,
+    M: VirtioMediaGuestMemoryMapper,
+    HM: VirtioMediaHostMemoryMapper,
+{
+    /// QBUF of a guest USERPTR buffer on a shadowed queue: its host MMAP twin is queued instead,
+    /// with an OUTPUT buffer's payload copied in first.
+    fn shadow_qbuf(
+        &mut self,
+        session: &mut V4l2Session<M>,
+        guest_buffer: V4l2Buffer,
+        guest_regions: Vec<Vec<SgEntry>>,
+    ) -> IoctlResult<V4l2Buffer> {
+        if guest_buffer.memory() != MemoryType::UserPtr {
+            return Err(libc::EINVAL);
+        }
+        let queue = guest_buffer.queue();
+        let writable = queue.direction() == QueueDirection::Capture;
+        let mut regions = guest_regions.into_iter();
+        let mut mappings = vec![];
+        for plane in guest_buffer.planes_iter() {
+            mappings.push(if *plane.length > 0 {
+                let sgs = regions.next().ok_or(libc::EINVAL)?;
+                Some(
+                    self.mem
+                        .new_mapping_for(sgs, writable)
+                        .map_err(|e| guest_mapping_errno(&e))?,
+                )
+            } else {
+                None
+            });
+        }
+
+        let sq = session.shadow_queue_mut(queue).ok_or(libc::EINVAL)?;
+        let sb = sq
+            .buffers
+            .get_mut(guest_buffer.index() as usize)
+            .ok_or(libc::EINVAL)?;
+        if sb.guest.is_some() {
+            return Err(libc::EINVAL);
+        }
+        let mut host_buffer = guest_buffer.clone();
+        set_memory(&mut host_buffer, MemoryType::Mmap);
+        {
+        if let V4l2PlanesWithBackingMut::Mmap(planes) = host_buffer.planes_with_backing_iter_mut() {
+            for (i, mut plane) in planes.enumerate() {
+                let (host_plane, offset) = sb.planes.get_mut(i).ok_or(libc::EINVAL)?;
+                plane.set_mem_offset(*offset);
+                *plane.length = host_plane.size() as u32;
+                if !writable {
+                    if let Some(Some(mapping)) = mappings.get(i) {
+                        let n = (*plane.bytesused as usize)
+                            .min(host_plane.size())
+                            .min(mapping.len());
+                        // SAFETY: `n` is within both the guest's mapping and the host plane's.
+                        unsafe {
+                            std::ptr::copy_nonoverlapping(
+                                mapping.as_ptr(),
+                                host_plane.as_mut().as_mut_ptr(),
+                                n,
+                            )
+                        };
+                    }
+                }
+            }
+        }
+        }
+        let host_out_buffer = v4l2r::ioctl::qbuf::<_, V4l2Buffer>(&session.device, host_buffer)
+            .map_err(|e| e.into_errno())?;
+        let out_buffer = shadow_buffer_to_guest(&host_out_buffer, Some(&guest_buffer));
+        if let Some(sb) = session
+            .shadow_queue_mut(queue)
+            .and_then(|sq| sq.buffers.get_mut(guest_buffer.index() as usize))
+        {
+            sb.guest = Some((guest_buffer, mappings));
+        }
+        Ok(out_buffer)
+    }
+}
