+/*
+ * piano: the pre-shared host arena (crosvm --pre-alloc drm-host-mb, the FDT's drm2kgsl_host pool), as DroidVM's
+ * drm2kgsl uses it.  A guest whose virtio-gpu maps host blobs only inside that pool (macOS: DroidVMVirtioGpu3D answers
+ * MAP_BLOB with MAP_INFO_POOL + offset) needs the one host blob a context has, its shmem ring, carved from there.
+ * crosvm exports the region as CROSVM_DRM2KGSL_ARENA_* and recognises the resource by its map_ptr in the window.
+ */
+struct msm_arena_extent {
+   uint64_t offset;
+   uint64_t size;
+   struct msm_arena_extent *next;
+};
+
+static struct {
+   pthread_mutex_t lock;
+   bool initialized;
+   bool enabled;
+   int fd;
+   uint64_t fd_offset;
+   uint8_t *host_va;
+   uint64_t size;
+   struct msm_arena_extent *free_list;
+} msm_arena = {
+   .lock = PTHREAD_MUTEX_INITIALIZER,
+   .fd = -1,
+};
+
+static bool
+msm_parse_u64_env(const char *name, uint64_t *value)
+{
+   const char *str = getenv(name);
+   if (!str || !*str)
+      return false;
+
+   char *end = NULL;
+   errno = 0;
+   unsigned long long parsed = strtoull(str, &end, 0);
+   if (errno || !end || *end)
+      return false;
+   *value = parsed;
+   return true;
+}
+
+static bool
+msm_arena_init(void)
+{
+   pthread_mutex_lock(&msm_arena.lock);
+   if (msm_arena.initialized) {
+      bool enabled = msm_arena.enabled;
+      pthread_mutex_unlock(&msm_arena.lock);
+      return enabled;
+   }
+   msm_arena.initialized = true;
+
+   uint64_t fd_value, host_va, size, fd_offset = 0;
+   if (!msm_parse_u64_env("CROSVM_DRM2KGSL_ARENA_FD", &fd_value) ||
+       !msm_parse_u64_env("CROSVM_DRM2KGSL_ARENA_HOST_VA", &host_va) ||
+       !msm_parse_u64_env("CROSVM_DRM2KGSL_ARENA_SIZE", &size) ||
+       fd_value > INT32_MAX || !host_va || !size ||
+       (host_va | size) & (getpagesize() - 1) ||
+       fcntl((int)fd_value, F_GETFD) < 0) {
+      pthread_mutex_unlock(&msm_arena.lock);
+      return false;
+   }
+   msm_parse_u64_env("CROSVM_DRM2KGSL_ARENA_FD_OFFSET", &fd_offset);
+
+   /* Never hand out the first 2 MiB: the Gunyah RM rejects a memparcel whose base is the base of the SHARE window it
+    * lives in (drm2kgsl's base guard). */
+   const uint64_t base_guard = 2ull << 20;
+   struct msm_arena_extent *extent = calloc(1, sizeof(*extent));
+   if ((fd_offset & (getpagesize() - 1)) || size <= base_guard || !extent) {
+      free(extent);
+      pthread_mutex_unlock(&msm_arena.lock);
+      drm_err("unusable arena: fd_offset=0x%" PRIx64 " size=0x%" PRIx64, fd_offset, size);
+      return false;
+   }
+   extent->offset = base_guard;
+   extent->size = size - base_guard;
+   msm_arena.fd = (int)fd_value;
+   msm_arena.fd_offset = fd_offset;
+   msm_arena.host_va = (uint8_t *)(uintptr_t)host_va;
+   msm_arena.size = size;
+   msm_arena.free_list = extent;
+   msm_arena.enabled = true;
+   pthread_mutex_unlock(&msm_arena.lock);
+
+   drm_log("pre-shared arena: fd=%d fd_offset=0x%" PRIx64 " host_va=%p size=0x%" PRIx64,
+           msm_arena.fd, msm_arena.fd_offset, (void *)msm_arena.host_va, msm_arena.size);
+   return true;
+}
+
+static bool
+msm_arena_alloc(uint64_t size, uint64_t *out_offset)
+{
+   size = ALIGN_POT(size, getpagesize());
+
+   pthread_mutex_lock(&msm_arena.lock);
+   struct msm_arena_extent **link = &msm_arena.free_list;
+   while (*link && (*link)->size < size)
+      link = &(*link)->next;
+   if (!*link) {
+      pthread_mutex_unlock(&msm_arena.lock);
+      return false;
+   }
+   struct msm_arena_extent *extent = *link;
+   *out_offset = extent->offset;
+   extent->offset += size;
+   extent->size -= size;
+   if (!extent->size) {
+      *link = extent->next;
+      free(extent);
+   }
+   pthread_mutex_unlock(&msm_arena.lock);
+   return true;
+}
+
+static void
+msm_arena_free(uint64_t offset, uint64_t size)
+{
+   size = ALIGN_POT(size, getpagesize());
+   struct msm_arena_extent *extent = calloc(1, sizeof(*extent));
+   if (!extent) {
+      drm_err("arena range 0x%" PRIx64 "+0x%" PRIx64 " leaked", offset, size);
+      return;
+   }
+   extent->offset = offset;
+   extent->size = size;
+
+   pthread_mutex_lock(&msm_arena.lock);
+   struct msm_arena_extent *prev = NULL, *next = msm_arena.free_list;
+   while (next && next->offset < offset) {
+      prev = next;
+      next = next->next;
+   }
+   extent->next = next;
+   if (prev)
+      prev->next = extent;
+   else
+      msm_arena.free_list = extent;
+   if (next && extent->offset + extent->size == next->offset) {
+      extent->size += next->size;
+      extent->next = next->next;
+      free(next);
+   }
+   if (prev && prev->offset + prev->size == extent->offset) {
+      prev->size += extent->size;
+      prev->next = extent->next;
+      free(extent);
+   }
+   pthread_mutex_unlock(&msm_arena.lock);
+}
