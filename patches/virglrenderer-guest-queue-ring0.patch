+/* piano: park the VMM's dma-buf for the guest-alloc blob whose get_blob() comes next */
+static int
+msm_renderer_set_guest_blob_fd(struct virgl_context *vctx, uint64_t blob_id, int fd)
+{
+   struct msm_context *mctx = to_msm_context(to_drm_context(vctx));
+
+   if (mctx->pending_guest_fd >= 0) {
+      drm_err("guest blob fd already pending (blob_id=%" PRIu64 "); dropping the stale one", blob_id);
+      close(mctx->pending_guest_fd);
+   }
+   mctx->pending_guest_fd = fd;
+   return 0;
+}
