+/* drm_context_get_shmem_blob() with the ring in the arena instead of a memfd of its own, whose mapping the guest could
+ * not reach.  Host and guest both map the arena cacheable. */
+static int
+msm_get_arena_shmem_blob(struct msm_context *mctx, uint64_t blob_size, uint32_t blob_flags,
+                         struct virgl_context_blob *blob)
+{
+   struct drm_context *dctx = &mctx->base;
+
+   if (blob_flags != VIRGL_RENDERER_BLOB_FLAG_USE_MAPPABLE) {
+      drm_err("invalid blob_flags: 0x%x", blob_flags);
+      return -EINVAL;
+   }
+   if (dctx->shmem || dctx->blob_size) {
+      drm_err("there can be only one!");
+      return -EINVAL;
+   }
+   if (blob_size < sizeof(*mctx->shmem) || blob_size > UINT32_MAX) {
+      drm_err("invalid blob size 0x%" PRIx64, blob_size);
+      return -EINVAL;
+   }
+
+   uint64_t offset;
+   if (!msm_arena_alloc(blob_size, &offset)) {
+      drm_err("arena exhausted for a shmem blob of 0x%" PRIx64, blob_size);
+      return -ENOMEM;
+   }
+   int fd = os_dupfd_cloexec(msm_arena.fd);
+   if (fd < 0) {
+      msm_arena_free(offset, blob_size);
+      return -ENOMEM;
+   }
+
+   uint8_t *ptr = msm_arena.host_va + offset;
+   memset(ptr, 0, blob_size);   /* ranges are recycled */
+
+   dctx->shmem = (struct vdrm_shmem *)ptr;
+   dctx->shmem->rsp_mem_offset = sizeof(*mctx->shmem);
+   dctx->rsp_mem = ptr + sizeof(*mctx->shmem);
+   dctx->rsp_mem_sz = blob_size - sizeof(*mctx->shmem);
+   dctx->blob_size = blob_size;
+   mctx->shmem_arena_backed = true;
+   mctx->shmem_arena_offset = offset;
+
+   blob->type = VIRGL_RESOURCE_FD_SHM;
+   blob->u.fd = fd;
+   blob->map_ptr = ptr;
+   blob->fd_offset = msm_arena.fd_offset + offset;
+   blob->map_info = VIRGL_RENDERER_MAP_CACHE_CACHED;
+   return 0;
+}
