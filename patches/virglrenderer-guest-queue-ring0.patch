+/* piano: set an iova, evicting what still holds the range: objects the guest already freed whose unref its kernel deferred
+ * (KGSL lets a bind replace a stale range; msm answers -ENOSPC). Their iovas are cleared, they leave the submit tables. */
+static int
+msm_set_iova_evicting(struct msm_context *mctx, struct msm_object *self, uint32_t handle, uint64_t iova, uint64_t size)
+{
+   uint64_t value = iova;
+   int ret = gem_info(mctx, handle, MSM_INFO_SET_IOVA, &value);
+   if (ret != -ENOSPC)
+      return ret;
+
+   unsigned evicted = 0;
+   const uint64_t end = iova + ALIGN_POT(size, getpagesize());
+   hash_table_foreach (mctx->base.resource_table, entry) {
+      struct msm_object *other = to_msm_object((struct drm_object *)entry->data);
+      if (other == self || !other->iova || !other->base.handle)
+         continue;
+      const uint64_t other_end = other->iova + ALIGN_POT(other->base.size, getpagesize());
+      if (other->iova < end && iova < other_end) {
+         uint64_t zero = 0;
+         if (!gem_info(mctx, other->base.handle, MSM_INFO_SET_IOVA, &zero)) {
+            other->iova = 0;
+            evicted++;
+         }
+      }
+   }
+   value = iova;
+   ret = gem_info(mctx, handle, MSM_INFO_SET_IOVA, &value);
+   drm_dbg("iova 0x%" PRIx64 "+0x%" PRIx64 ": %u stale object(s) evicted, ret %d", iova, size, evicted, ret);
+   return ret;
+}
