+// Whether device `d`'s card names `role` ("decoder", "encoder"), in any case: MediaCodec's cards say "c2.qti.avc.decoder", a
+// Linux host's V4L2 driver its own name ("Iris Decoder" on the SM8750's Iris).
+static bool cardIs(unsigned d, const char *role) {
+    const char *card = droidvm_media_card(d);
+    const size_t n = strlen(role);
+    for (size_t i = 0; card[i] && i < 33; ++i) {
+        size_t j = 0;
+        while (j < n && card[i + j] && (card[i + j] | 0x20) == role[j]) ++j;
+        if (j == n) return true;
+    }
+    return false;
+}
