diff --git a/board.toml b/board.toml
index 9bc5aa2..9f8842d 100644
--- a/board.toml
+++ b/board.toml
@@ -36,17 +36,9 @@ archives = [
   # build/reference-candidate/kernel.{macho,json}, a prelinked kernel of this board built WITHOUT
   # CONFIG_XNU_NATIVE_VIRTIO_BLOCK / RAM_BLOCK / LEGACY_DISPLAY (original kext addresses do not move between
   # builds). A build from scratch therefore links one such kernel first and copies it there.
-  "audit-storage-interface-static.py",
   # Owner root: OS + SystemOS policies (build-owner-os-policy.py, build-owner-systemos-policy.py) must exist.
-  "build-verified-root-probe.py --component os --include-systemos",
-  "build-arm-driver.py NativeVirtioBlock --verified-root --verified-root-bundle",
-  "build-native-virtio-bindings.py --component NativeVirtioBlock --directory build/native-virtio-block-verified-bundle",
-  "build-arm-driver.py NativeRamBlock",
-  "build-native-virtio-bindings.py --component NativeRamBlock --directory build/native-ram-block",
   "build-libpthread-kernel.py",
   # The paravirtual Adreno over crosvm's droidvm-gpu device (the host's KGSL); its objects ride in the display archive below.
-  "build-droidvm-gpu.py",
-  "build-native-legacy-display.py",
 ]
 
 [kernel.prelink]
